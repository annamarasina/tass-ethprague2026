{
  "name": "solid-scan",
  "displayName": "Solid Scan",
  "description": "Autonomous smart contract audit agent for VS Code.",
  "version": "0.0.1",
  "publisher": "solidscan",
  "private": true,
  "engines": {
    "vscode": "^1.82.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*",
    "onCommand:solidScan.runAudit",
    "onView:solidScan.sidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "solidScan.runAudit",
        "title": "Solid Scan: Run Audit",
        "category": "Solid Scan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "solidScan",
          "title": "Solid Scan",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "solidScan": [
        {
          "id": "solidScan.sidebar",
          "name": "Audit",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "postcompile": "node ./scripts/copy-webview-assets.mjs",
    "watch": "tsc -watch -p .",
    "check": "tsc -p . --noEmit",
    "demo:check": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@types/vscode": "^1.105.0",
    "typescript": "^6.0.3"
  }
}
